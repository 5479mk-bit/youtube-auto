# 공공데이터포털(data.go.kr) 서비스키 — 무료 발급 후 Decoding 키를 넣는다
DATA_GO_KR_SERVICE_KEY=

# 대본 생성 LLM. provider 는 config.yaml 의 script.llm.provider 로 선택한다.
# gemini 무료 티어를 기본으로 상정한다.
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=

# 텔레그램 검수 봇
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# YouTube Data API v3 (OAuth 2.0 데스크톱 클라이언트)
YOUTUBE_CLIENT_SECRET_FILE=credentials/youtube_client_secret.json
YOUTUBE_TOKEN_FILE=credentials/youtube_token.json

# --- Vertex AI (구글 클라우드) ---
# AI Studio 선불 잔액이 아니라 GCP 크레딧으로 생성 비용을 내려면 아래 둘이 필요하다.
# 서비스 계정에는 roles/aiplatform.user 권한을 주고, 프로젝트에 Vertex AI API 를 켠다.
VERTEX_PROJECT_ID=
VERTEX_SERVICE_ACCOUNT_FILE=credentials/vertex-sa.json
